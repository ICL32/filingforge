<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FilingForge</RootNamespace>
    <PackageId>FilingForge</PackageId>
    <Version>0.1.0</Version>
    <Description>Rebuilds standardized quarterly, annual and TTM financial statements from SEC EDGAR XBRL data and filing documents.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>sec;edgar;xbrl;financial-statements;fundamentals</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FilingForge.Tests" />
  </ItemGroup>
</Project>
